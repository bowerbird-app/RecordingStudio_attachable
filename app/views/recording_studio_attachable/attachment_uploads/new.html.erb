<% if @upload_modal %>
  <turbo-frame id="<%= @upload_frame_id %>">
    <%= render "recording_studio_attachable/attachment_uploads/uploader", modal: true %>
  </turbo-frame>
<% else %>
  <% content_for :title, t("recording_studio.attachable.upload.title") %>
  <% content_for :subtitle, t("recording_studio.attachable.upload.subtitle", types: attachable_upload_type_labels(@allowed_content_types).to_sentence, size: number_to_human_size(@max_file_size)) %>
  <% flat_pack_page_nav(
    round: true,
    style: :default,
    back_tooltip: t("recording_studio.attachable.navigation.back"),
    anchor_href: attachment_page_nav_anchor_url(fallback: recording_attachments_path(@recording)),
    anchor_tooltip: t("recording_studio.attachable.navigation.return_to_source")
  ) %>

  <%= render "recording_studio_attachable/attachment_uploads/uploader", modal: false %>
<% end %>
