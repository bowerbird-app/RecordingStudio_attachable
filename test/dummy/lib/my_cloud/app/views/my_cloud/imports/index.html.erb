<%= render "recording_studio_attachable/providers/remote_file_browser",
           provider_label: provider_label,
           reconnect: @reconnect,
           show_connect: @show_connect,
           connect_url: my_cloud.recording_connect_path(@recording, **upload_flow_params),
           connect_method: :post,
           connect_fields: { authenticity_token: form_authenticity_token },
           files: @files,
           query: @query,
           import_url: my_cloud.recording_imports_path(@recording),
           search_url: my_cloud.recording_imports_path(@recording),
           disconnect_url: my_cloud.recording_disconnect_path(@recording),
           recording: @recording %>
