<% if collection.rows.empty? %>
  <p class="text-sm text-(--surface-muted-content-color)"><%= collection.empty_message %></p>
<% else %>
  <% carousel = collection.displays.include?(:carousel) %>
  <% list = collection.displays.include?(:list) %>
  <% grid = collection.displays.include?(:grid) %>
  <% interactive = carousel || grid %>
  <% open_slides = carousel && collection.default_display == :carousel %>
  <% open_grid = grid && collection.default_display == :grid %>
  <% preview_on_slide = carousel && (open_slides || !list) %>
  <div class="flex w-full flex-col gap-4<%= " group" if carousel %>"
       <% if interactive %>
         data-controller="recording-studio-attachable--collection-display"
         data-display="<%= collection.default_display %>"
         data-recording-studio-attachable--collection-display-display-value="<%= collection.default_display %>"
         data-recording-studio-attachable--collection-display-active-classes-value="<%= FlatPack::Button::Pill::Component::ITEM_ACTIVE_CLASSES %>"
         data-recording-studio-attachable--collection-display-inactive-classes-value="<%= FlatPack::Button::Pill::Component::ITEM_INACTIVE_CLASSES %>"
       <% end %>>
    <% if collection.displays.size > 1 %>
      <%= render FlatPack::Button::Pill::Component.new(
        items: collection.displays.map { |display|
          {
            text: RecordingStudioAttachable::AttachmentCollectionDisplay.label(display),
            href: "##{display}",
            active: display == collection.default_display,
            data: {
              turbo: false,
              action: "click->recording-studio-attachable--collection-display#select",
              recording_studio_attachable__collection_display_target: "pill",
              display: display
            }
          }
        }
      ) %>
    <% end %>

    <% collection.rows.each do |row| %>
      <%= form_with url: attachable_destroy_attachment_path(row.recording, **RecordingStudioAttachable::AttachmentFileButton.redirect_params(return_to: return_to)),
                    method: :delete,
                    id: "#{collection.form_id}-trash-#{row.recording.id}",
                    html: { hidden: true } do %>
      <% end %>
    <% end %>

    <% if carousel %>
      <% slides = collection.rows.map do |row|
           {
             type: :html,
             html: tag.div(class: "slide-placeholder"),
             thumb_src: authorized_attachment_preview_path(row.recording, collection.preview_variant)
           }
         end %>
      <div data-recording-studio-attachable--collection-display-target="carousel" <% unless open_slides %>hidden<% end %>>
        <%= render FlatPack::Carousel::Component.new(
          slides: slides,
          initial_index: 0,
          loop: false,
          autoplay: false,
          show_captions: false,
          show_thumbs: true,
          thumbs_position: :bottom,
          show_border: false,
          show_background: false,
          show_controls: collection.rows.many?,
          show_indicators: false,
          side_preview: collection.side_preview,
          items_per_view_mobile: collection.items_per_view.mobile,
          items_per_view_tablet: collection.items_per_view.tablet,
          items_per_view_desktop: collection.items_per_view.desktop,
          aspect_ratio: collection.square_preview? ? "1/1" : "4/3",
          aria_label: "Images"
        ) %>
        <div hidden>
          <% collection.rows.each do |row| %>
            <% attachment = row.recording.recordable %>
            <% preview_path = authorized_attachment_preview_path(row.recording, collection.preview_variant) %>
            <% file_path = preview_path.present? ? authorized_attachment_file_path(row.recording) : nil %>
            <% file_extension = File.extname(attachment.original_filename.to_s).delete(".").upcase.presence || "FILE" %>
            <% slide_form_id = "#{collection.form_id}-slide-#{row.recording.id}" %>
            <%= form_with url: url,
                          method: :patch,
                          id: slide_form_id,
                          class: "w-full",
                          data: {
                            controller: "flat-pack--unsaved-changes",
                            turbo: false,
                            action: "submit->recording-studio-attachable--collection-display#saveSlide",
                            recording_studio_attachable__collection_display_target: "slideForm"
                          } do %>
              <%= hidden_field_tag "attachment_collection[signed_editor]", collection.signed_editor %>
              <% RecordingStudioAttachable::AttachmentFileButton.redirect_params(return_to: return_to).each do |key, value| %>
                <%= hidden_field_tag key, value %>
              <% end %>
              <%= render FlatPack::Card::Component.new(
                    style: :default,
                    class: "w-full",
                    data: {
                      recording_studio_attachable__collection_display_target: "card",
                      lightbox_src: file_path.presence,
                      lightbox_alt: attachment.name.to_s.presence
                    }.compact
                  ) do |card| %>
                <% media_options = { padding: :none, data: { recording_studio_attachable__collection_display_target: "slideMedia" } } %>
                <% media_options[:hidden] = true unless preview_on_slide %>
                <% card.media(**media_options) do %>
                  <% if preview_on_slide %>
                    <%= render "recording_studio_attachable/attachment_collections/row_preview",
                          collection: collection,
                          row: row,
                          attachment: attachment,
                          preview_path: preview_path,
                          file_path: file_path,
                          file_extension: file_extension,
                          carousel: true %>
                  <% end %>
                <% end %>
                <% card.body do %>
                  <div class="flex flex-col gap-4">
                    <%= render "recording_studio_attachable/attachment_collections/file_facts", attachment: attachment %>
                    <%= render "recording_studio_attachable/attachment_collections/fields",
                          collection: collection,
                          row: row,
                          form_id: slide_form_id,
                          show_order: false %>
                    <div class="flex items-center justify-between gap-4">
                      <div class="inline-flex items-center gap-3">
                        <%= render FlatPack::Button::Component.new(
                              text: "Save",
                              style: :default,
                              size: :md,
                              type: "submit",
                              form: slide_form_id,
                              data: { flat_pack__unsaved_changes_target: "submit" }
                            ) %>
                        <p class="text-sm text-(--surface-muted-content-color)" data-save-status role="status" hidden></p>
                      </div>
                      <%= render FlatPack::Button::Component.new(
                            text: "Trash",
                            icon: "trash",
                            icon_only: true,
                            style: :danger,
                            size: :md,
                            type: "submit",
                            form: "#{collection.form_id}-trash-#{row.recording.id}"
                          ) %>
                    </div>
                  </div>
                <% end %>
              <% end %>
            <% end %>
          <% end %>
        </div>
      </div>
    <% end %>

    <% if grid %>
      <%= render "recording_studio_attachable/attachment_collections/grid",
            collection: collection,
            url: url,
            return_to: return_to,
            open_grid: open_grid %>
    <% end %>

    <% if list %>
      <% list_data = { controller: "flat-pack--unsaved-changes" } %>
      <% list_data[:recording_studio_attachable__collection_display_target] = "list" if interactive %>
      <%= form_with url: url,
                    method: :patch,
                    id: collection.form_id,
                    class: "flex w-full flex-col gap-4",
                    data: list_data,
                    html: ((interactive && collection.default_display != :list) ? { hidden: true } : {}) do %>
        <%= hidden_field_tag "attachment_collection[signed_editor]", collection.signed_editor %>
        <% RecordingStudioAttachable::AttachmentFileButton.redirect_params(return_to: return_to).each do |key, value| %>
          <%= hidden_field_tag key, value %>
        <% end %>

        <ol class="flex flex-col gap-4" <% if collection.sortable? %>data-controller="recording-studio-attachable--collection-order"<% end %>>
          <% collection.rows.each do |row| %>
            <% attachment = row.recording.recordable %>
            <% preview_path = authorized_attachment_preview_path(row.recording, collection.preview_variant) %>
            <% file_path = preview_path.present? ? authorized_attachment_file_path(row.recording) : nil %>
            <% file_extension = File.extname(attachment.original_filename.to_s).delete(".").upcase.presence || "FILE" %>
            <li <% if collection.sortable? %>data-recording-studio-attachable--collection-order-target="row"<% end %>>
              <%= render FlatPack::Card::Component.new(style: :default, class: "w-full") do |card| %>
                <% card.body do %>
                  <div class="flex flex-col gap-4 sm:flex-row sm:items-start">
                    <% if collection.sortable? %>
                      <%= render FlatPack::Button::Component.new(
                        text: "Drag",
                        style: :ghost,
                        size: :md,
                        type: "button",
                        data: {
                          action: "pointerdown->recording-studio-attachable--collection-order#grab pointermove->recording-studio-attachable--collection-order#move pointerup->recording-studio-attachable--collection-order#release pointercancel->recording-studio-attachable--collection-order#release"
                        }
                      ) %>
                    <% end %>

                    <div class="w-full sm:w-52 sm:max-w-52" <% if carousel %>data-recording-studio-attachable--collection-display-target="previewHome" <% if preview_on_slide %>hidden<% end %><% end %>>
                      <% unless preview_on_slide %>
                        <%= render "recording_studio_attachable/attachment_collections/row_preview",
                              collection: collection,
                              row: row,
                              attachment: attachment,
                              preview_path: preview_path,
                              file_path: file_path,
                              file_extension: file_extension,
                              carousel: carousel %>
                      <% end %>
                    </div>

                    <div class="flex min-w-0 flex-1 flex-col gap-4">
                      <%= render "recording_studio_attachable/attachment_collections/fields",
                            collection: collection,
                            row: row,
                            form_id: collection.form_id,
                            show_order: collection.sortable? %>
                      <div class="inline-flex">
                        <%= render FlatPack::Button::Component.new(
                              text: "Trash",
                              icon: "trash",
                              style: :danger,
                              size: :md,
                              type: "submit",
                              form: "#{collection.form_id}-trash-#{row.recording.id}"
                            ) %>
                      </div>
                    </div>
                  </div>
                <% end %>
              <% end %>
            </li>
          <% end %>
        </ol>

        <div class="inline-flex">
          <%= render FlatPack::Button::Component.new(
                text: "Save",
                style: :default,
                size: :md,
                type: "submit",
                form: collection.form_id,
                data: { flat_pack__unsaved_changes_target: "submit" }
              ) %>
        </div>
      <% end %>
    <% end %>
  </div>
<% end %>
