<% content_for :title, "Demo cloud import" %>
<% content_for :subtitle, "Reference provider flow for recording ##{@recording.id}" %>
<% flat_pack_page_nav(
  round: true,
  style: :default,
  back_icon: "chevron-left",
  back_tooltip: "Go back",
  anchor_href: recording_studio_attachable.recording_attachment_upload_path(@recording),
  anchor_tooltip: "Close"
) %>
<div class="mx-auto flex w-full max-w-4xl flex-col gap-6">

  <div class="rounded-xl border border-[var(--surface-border-color)] bg-[var(--surface-background-color)] p-6">
    <div class="space-y-4">
      <p class="text-sm text-[var(--surface-muted-content-color)]">
        This dummy page uses the public provider import API to create a sample SVG attachment through the same validation and recording flow as the main uploader.
      </p>

      <div class="flex flex-wrap items-center gap-3">
        <%= form_with url: demo_upload_provider_path(recording_id: @recording.id), method: :post, class: "inline-flex" do %>
          <%= render FlatPack::Button::Component.new(text: "Import sample image", style: :primary, size: :md, type: "submit", icon: "cloud") %>
        <% end %>

        <%= render FlatPack::Button::Component.new(
          text: "Back to upload page",
          style: :secondary,
          size: :md,
          href: recording_studio_attachable.recording_attachment_upload_path(@recording)
        ) %>
      </div>
    </div>
  </div>
</div>