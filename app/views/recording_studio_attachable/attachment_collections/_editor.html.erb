<% if collection.rows.empty? %>
  <p class="text-sm text-(--surface-muted-content-color)"><%= collection.empty_message %></p>
<% else %>
  <% carousel = collection.displays.include?(:carousel) %>
  <% open_slides = collection.default_display == :carousel %>
  <div class="<%= "group flex w-full flex-col gap-4" if carousel %>"
       <% if carousel %>
         data-controller="recording-studio-attachable--collection-display"
         data-display="<%= collection.default_display %>"
         data-recording-studio-attachable--collection-display-display-value="<%= collection.default_display %>"
         data-recording-studio-attachable--collection-display-active-classes-value="<%= FlatPack::Button::Pill::Component::ITEM_ACTIVE_CLASSES %>"
         data-recording-studio-attachable--collection-display-inactive-classes-value="<%= FlatPack::Button::Pill::Component::ITEM_INACTIVE_CLASSES %>"
       <% end %>>
    <% if collection.displays.size > 1 %>
      <%= render FlatPack::Button::Pill::Component.new(
        items: collection.displays.map { |display|
          {
            text: RecordingStudioAttachable::AttachmentCollectionDisplay.label(display),
            href: "##{display}",
            active: display == collection.default_display,
            data: {
              turbo: false,
              action: "click->recording-studio-attachable--collection-display#select",
              recording_studio_attachable__collection_display_target: "pill",
              display: display
            }
          }
        }
      ) %>
    <% end %>

    <%= form_with url: url, method: :patch, id: collection.form_id do %>
      <%= hidden_field_tag "attachment_collection[signed_editor]", collection.signed_editor %>
      <% RecordingStudioAttachable::AttachmentFileButton.redirect_params(return_to: return_to).each do |key, value| %>
        <%= hidden_field_tag key, value %>
      <% end %>
    <% end %>

    <% if carousel && collection.rows.many? %>
      <div class="flex items-center justify-between gap-3" data-recording-studio-attachable--collection-display-target="pager" <% unless open_slides %>hidden<% end %>>
        <%= render FlatPack::Button::Component.new(
          text: "Previous",
          icon: "arrow-left",
          style: :secondary,
          size: :md,
          type: "button",
          disabled: open_slides,
          data: {
            recording_studio_attachable__collection_display_target: "previous",
            action: "click->recording-studio-attachable--collection-display#previous"
          }
        ) %>
        <p class="text-sm text-(--surface-muted-content-color)" data-recording-studio-attachable--collection-display-target="counter">1 of <%= collection.rows.size %></p>
        <%= render FlatPack::Button::Component.new(
          text: "Next",
          icon: "arrow-right",
          style: :secondary,
          size: :md,
          type: "button",
          data: {
            recording_studio_attachable__collection_display_target: "next",
            action: "click->recording-studio-attachable--collection-display#next"
          }
        ) %>
      </div>
    <% end %>

    <ol class="flex flex-col gap-4" <% if collection.sortable? %>data-controller="recording-studio-attachable--collection-order"<% end %>>
      <% collection.rows.each_with_index do |row, index| %>
        <% attachment = row.recording.recordable %>
        <% preview_path = authorized_attachment_preview_path(row.recording, collection.preview_variant) %>
        <% file_extension = File.extname(attachment.original_filename.to_s).delete(".").upcase.presence || "FILE" %>
        <% row_class = if carousel
             "flex flex-col gap-4 border-b border-(--surface-border-color) pb-4 group-data-[display=list]:sm:flex-row group-data-[display=list]:sm:items-start"
           else
             "flex flex-col gap-4 border-b border-(--surface-border-color) pb-4 sm:flex-row sm:items-start"
           end %>
        <% preview_class = if carousel
             "w-full group-data-[display=list]:sm:w-52 group-data-[display=list]:sm:max-w-52 group-data-[display=carousel]:mx-auto group-data-[display=carousel]:max-w-xl"
           else
             "w-full sm:w-52 sm:max-w-52"
           end %>
        <li class="<%= row_class %>"
            <% if carousel %>
              data-recording-studio-attachable--collection-display-target="row"
              <% if open_slides && index.positive? %>hidden<% end %>
            <% end %>
            <% if collection.sortable? %>data-recording-studio-attachable--collection-order-target="row"<% end %>>
          <% if collection.sortable? %>
            <div <% if carousel %>data-recording-studio-attachable--collection-display-target="listOnly" <% if open_slides %>hidden<% end %><% end %>>
              <%= render FlatPack::Button::Component.new(
                text: "Drag",
                style: :ghost,
                size: :md,
                type: "button",
                data: {
                  action: "pointerdown->recording-studio-attachable--collection-order#grab pointermove->recording-studio-attachable--collection-order#move pointerup->recording-studio-attachable--collection-order#release pointercancel->recording-studio-attachable--collection-order#release"
                }
              ) %>
            </div>
          <% end %>

          <div class="<%= preview_class %>">
            <% if preview_path.present? %>
              <% file_path = authorized_attachment_file_path(row.recording) %>
              <% modal_id = "attachment-image-#{row.recording.id}" %>
              <% frame_class = collection.square_preview? ? "relative aspect-square" : "relative flex min-h-32 items-center justify-center" %>
              <% image_class = if collection.square_preview?
                   "h-full w-full object-cover"
                 elsif carousel
                   "max-h-72 w-full object-contain group-data-[display=carousel]:max-h-[32rem]"
                 else
                   "max-h-72 w-full object-contain"
                 end %>
              <button type="button" class="block w-full cursor-pointer overflow-hidden rounded-lg" data-modal-id="<%= modal_id %>" aria-label="View <%= attachment.name %>">
                <div class="<%= frame_class %>" data-controller="recording-studio-attachable--image-fallback">
                  <%= image_tag preview_path,
                                alt: attachment.name,
                                class: image_class,
                                data: {
                                  recording_studio_attachable__image_fallback_target: "image",
                                  action: "error->recording-studio-attachable--image-fallback#showFallback"
                                } %>
                  <div class="absolute inset-0 hidden items-center justify-center bg-(--surface-background-color)" data-recording-studio-attachable--image-fallback-target="fallback">
                    <span class="text-xs font-semibold uppercase tracking-[0.18em] text-(--surface-muted-content-color)">IMAGE</span>
                  </div>
                </div>
              </button>
              <%= render FlatPack::Modal::Component.new(id: modal_id, title: attachment.name, size: :xl) do |modal| %>
                <% modal.body do %>
                  <%= image_tag file_path, alt: attachment.name, class: "mx-auto max-h-[70vh] w-full object-contain" %>
                <% end %>
              <% end %>
            <% else %>
              <div class="flex aspect-square w-full items-center justify-center rounded-lg bg-(--surface-background-color) text-(--surface-content-color) shadow-sm ring-1 ring-(--surface-border-color)">
                <span class="text-xs font-semibold uppercase tracking-[0.18em] text-(--surface-muted-content-color)"><%= file_extension %></span>
              </div>
            <% end %>
          </div>

          <div class="flex min-w-0 flex-1 flex-col gap-4">
            <%= hidden_field_tag collection.input_name(:recording_id), row.recording.id, form: collection.form_id %>
            <% collection.fields.each do |field| %>
              <% if field.control == :area %>
                <div>
                  <label class="mb-2 block text-sm font-medium"><%= field.label %></label>
                  <%= text_area_tag collection.input_name(field.key),
                                    row.values[field.key],
                                    form: collection.form_id,
                                    class: "min-h-24 w-full rounded-lg border border-[var(--surface-border-color)] bg-transparent px-3 py-2" %>
                </div>
              <% else %>
                <%= render FlatPack::TextInput::Component.new(
                  name: collection.input_name(field.key),
                  label: field.label,
                  value: row.values[field.key],
                  required: field.key == :name,
                  form: collection.form_id
                ) %>
              <% end %>
            <% end %>
            <% if collection.sortable? %>
              <div <% if carousel %>data-recording-studio-attachable--collection-display-target="listOnly" <% if open_slides %>hidden<% end %><% end %>>
                <%= render FlatPack::TextInput::Component.new(
                  name: collection.input_name(:order),
                  label: "Order",
                  value: row.order,
                  form: collection.form_id,
                  data: { recording_studio_attachable__collection_order_target: "order" }
                ) %>
              </div>
            <% end %>
            <%= form_with url: attachable_destroy_attachment_path(row.recording, **RecordingStudioAttachable::AttachmentFileButton.redirect_params(return_to: return_to)),
                          method: :delete,
                          class: "inline-flex" do %>
              <%= render FlatPack::Button::Component.new(text: "Trash", icon: "trash", style: :danger, size: :md, type: "submit") %>
            <% end %>
          </div>
        </li>
      <% end %>
    </ol>

    <%= render FlatPack::Button::Component.new(text: "Save", style: :primary, size: :md, type: "submit", form: collection.form_id) %>
  </div>
<% end %>
