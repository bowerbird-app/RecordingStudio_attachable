<% if @upload_modal %>
  <turbo-frame id="<%= @upload_frame_id %>">
    <%= render "recording_studio_attachable/attachment_uploads/uploader", modal: true %>
  </turbo-frame>
<% else %>
  <div class="mx-auto flex w-full max-w-6xl flex-col gap-6">
    <%= render FlatPack::PageNav::Component.new(
      back_icon: "arrow-left",
      back_label: t("recording_studio.attachable.navigation.back"),
      anchor_url: attachment_page_nav_anchor_url(fallback: recording_attachments_path(@recording)),
      anchor_label: t("recording_studio.attachable.navigation.return_to_source")
    ) %>

    <%= render FlatPack::PageTitle::Component.new(
      title: t("recording_studio.attachable.upload.title"),
      subtitle: t("recording_studio.attachable.upload.subtitle", types: attachable_upload_type_labels(@allowed_content_types).to_sentence, size: number_to_human_size(@max_file_size)),
      variant: :h1
    ) %>

    <%= render "recording_studio_attachable/attachment_uploads/uploader", modal: false %>
  </div>
<% end %>
