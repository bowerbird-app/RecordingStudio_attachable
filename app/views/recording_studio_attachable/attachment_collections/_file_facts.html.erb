<% facts = RecordingStudioAttachable::AttachmentFileFacts.new(attachment) %>
<% if facts.any? %>
  <%# px-14 keeps this line clear of the round previous and next buttons. %>
  <% clear_controls = local_assigns.fetch(:clear_controls, true) %>
  <div class="flex min-w-0 flex-col gap-3<%= " px-14" if clear_controls %>">
    <% if facts.filename %>
      <p class="truncate text-xs text-(--surface-muted-content-color)"><%= facts.filename %></p>
    <% end %>
    <% if facts.labels.any? %>
      <div class="flex flex-wrap gap-3">
        <% facts.labels.each do |label| %>
          <%= render FlatPack::Badge::Component.new(text: label, style: :default, size: :sm) %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
