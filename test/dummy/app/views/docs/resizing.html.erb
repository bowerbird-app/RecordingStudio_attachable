<div class="mx-auto flex w-full max-w-4xl flex-col gap-8">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Resizing",
    subtitle: "Configure browser-side image resizing, named delivery variants, upload-time preprocessing, and Rails versus direct URL modes.",
    variant: :h1
  ) %>

  <section class="space-y-3">
    <%= render FlatPack::SectionTitle::Component.new(
      title: "Browser-side resizing",
      subtitle: "Resize oversized JPEG, PNG, and WebP files before direct upload so the shared upload flows can reduce byte size without changing the server-side validation contract.",
      anchor_link: true
    ) %>

    <%= render FlatPack::CodeBlock::Component.new(
      title: "config/initializers/recording_studio_attachable.rb",
      code: @resizing_config_example,
      language: :ruby
    ) %>
  </section>

  <section class="space-y-3">
    <%= render FlatPack::SectionTitle::Component.new(
      title: "Size variants",
      subtitle: "Named delivery variants are stored in Active Storage. Preprocess common sizes after upload, or let Rails mode process them on the first preview request.",
      anchor_link: true
    ) %>

    <%= render FlatPack::CodeBlock::Component.new(
      title: "config/initializers/recording_studio_attachable.rb",
      code: @variant_config_example,
      language: :ruby
    ) %>
  </section>

  <section class="space-y-3">
    <%= render FlatPack::SectionTitle::Component.new(
      title: "URL modes",
      subtitle: "Rails mode keeps authorized engine paths. Direct mode builds public custom-domain links from blob keys. Studio UI stays on Rails paths unless the host sets url_mode to direct.",
      anchor_link: true
    ) %>

    <%= render FlatPack::CodeBlock::Component.new(
      title: "config/initializers/recording_studio_attachable.rb",
      code: @url_mode_config_example,
      language: :ruby
    ) %>
  </section>
</div>
