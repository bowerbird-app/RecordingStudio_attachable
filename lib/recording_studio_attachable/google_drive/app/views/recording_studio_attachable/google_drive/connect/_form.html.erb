<% reconnect = local_assigns.fetch(:reconnect, false) %>
<% auto_submit = local_assigns.fetch(:auto_submit, false) %>
<% connect_path = local_assigns.fetch(:oauth_connect_path) %>
<% return_to = local_assigns.fetch(:oauth_return_to) %>
<% form_html = { id: ("google-drive-oauth-connect" if auto_submit) }.compact %>

<div class="space-y-4" data-controller="recording-studio-attachable--provider-modal-frame">
  <p class="text-sm text-(--surface-muted-content-color)">
    <% if reconnect %>
      <%= t("recording_studio.attachable.google_drive.reconnect_help") %>
    <% else %>
      <%= t("recording_studio.attachable.google_drive.connect_help") %>
    <% end %>
  </p>

  <% if connect_path.present? %>
    <%= form_with url: connect_path, method: :post, html: form_html, class: "inline-flex" do %>
      <%= hidden_field_tag :owner, "user" %>
      <%= hidden_field_tag :return_to, return_to %>
      <%= render FlatPack::Button::Component.new(
        text: t(reconnect ? "recording_studio.attachable.google_drive.reconnect" : "recording_studio.attachable.google_drive.connect"),
        style: reconnect ? :danger : :primary,
        size: :md,
        icon: "cloud",
        type: "submit"
      ) %>
    <% end %>
  <% end %>
</div>

<% if auto_submit && connect_path.present? %>
  <script>
    document.getElementById("google-drive-oauth-connect")?.submit()
  </script>
<% end %>
