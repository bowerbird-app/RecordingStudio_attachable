<% content_for :title, @page.title %>
<% content_for :subtitle, "Single-file attachable parent. Host owns the Turbo frames; Attachable supplies the file button and preview URL." %>
<% flat_pack_page_nav(
  round: true,
  style: :default,
  back_tooltip: "Go back",
  anchor_href: root_path,
  anchor_tooltip: "Close"
) %>
<div id="attachment-chromes-demo" class="flex w-full flex-col gap-10">

  <section class="flex flex-col gap-3">
    <h2 class="text-base font-medium text-(--surface-content-color)">Avatar + file button</h2>
    <%= turbo_frame_tag "page-avatar-attachment" do %>
      <div class="inline-flex items-end gap-3">
        <%= render FlatPack::Avatar::Component.new(
          src: attachment_preview_url(@page_recording),
          alt: attachment_preview_url(@page_recording).present? ? @page.title : nil,
          size: :"2xl",
          shape: :circle,
          show_tooltip: false
        ) %>
        <%= render_attachment_file_button(@page_recording, return_to: @return_to) %>
      </div>
    <% end %>
  </section>

  <section class="flex flex-col gap-3">
    <h2 class="text-base font-medium text-(--surface-content-color)">File button only</h2>
    <%= turbo_frame_tag "page-file-button" do %>
      <%= render_attachment_file_button(@page_recording, return_to: @return_to) %>
    <% end %>
  </section>
</div>
