<div id="user-profile-product" class="mx-auto flex w-full max-w-4xl flex-col gap-6">
  <%= render FlatPack::PageNav::Component.new(
    back_icon: "chevron-left",
    back_label: "Go back",
    anchor_url: root_path,
    anchor_label: "Close"
  ) %>

  <%= render FlatPack::PageTitle::Component.new(
    title: @user.name,
    subtitle: "Product designer · Melbourne",
    variant: :h1
  ) %>

  <%= render_parent_attachment(@user_recording, return_to: @return_to) %>
</div>

<dl class="mx-auto mt-6 grid w-full max-w-4xl gap-3 text-sm">
  <div>
    <dt class="font-medium text-(--surface-content-color)">Email</dt>
    <dd class="text-(--surface-muted-content-color)"><%= @user.email %></dd>
  </div>
</dl>
