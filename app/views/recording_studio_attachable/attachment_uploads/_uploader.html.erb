<%
  embedded = local_assigns.fetch(:modal, false)
  # A provider that opens its own modal page cannot open inside this modal.
  upload_providers = embedded ? @upload_providers.reject(&:modal?) : @upload_providers

  remove_button_template = render(
    FlatPack::Button::Component.new(
      text: t("recording_studio.attachable.upload.remove"),
      style: :ghost,
      size: :md,
      type: "button",
      class: "absolute right-2 top-2",
      data: {
        action: "recording-studio-attachable--upload#remove",
        id: "__ENTRY_ID__"
      },
      aria: { label: "__REMOVE_LABEL__" },
      title: "__REMOVE_TITLE__"
    )
  ).squish
%>

<div class="flex w-full flex-col gap-6"
     data-controller="recording-studio-attachable--upload"
     data-recording-studio-attachable--upload-direct-upload-url-value="<%= recording_direct_uploads_path(@recording) %>"
     data-recording-studio-attachable--upload-finalize-url-value="<%= @create_path %>"
     data-recording-studio-attachable--upload-max-file-size-value="<%= @max_file_size %>"
     data-recording-studio-attachable--upload-max-files-count-value="<%= @max_file_count %>"
     data-recording-studio-attachable--upload-image-processing-enabled-value="<%= @image_processing_enabled %>"
     data-recording-studio-attachable--upload-image-processing-max-width-value="<%= @image_processing_max_width %>"
     data-recording-studio-attachable--upload-image-processing-max-height-value="<%= @image_processing_max_height %>"
     data-recording-studio-attachable--upload-image-processing-quality-value="<%= @image_processing_quality %>"
     data-recording-studio-attachable--upload-remove-button-template-value="<%= remove_button_template %>"
     data-recording-studio-attachable--upload-allowed-content-types-value="<%= @allowed_content_types.join(",") %>"
     data-recording-studio-attachable--upload-i18n-value="<%= ERB::Util.html_escape(attachable_upload_js_i18n.to_json) %>"
     data-recording-studio-attachable--upload-success-behavior-value="<%= embedded ? "event" : "redirect" %>"
     data-recording-studio-attachable--upload-csrf-token-value="<%= form_authenticity_token %>">
  <% upload_provider_launcher_modules(upload_providers).each do |module_path| %>
    <%= javascript_tag(%(import #{module_path.to_json}), type: "module", nonce: true) %>
  <% end %>
  <% if embedded %>
    <p class="text-sm text-(--surface-muted-content-color)"><%= t("recording_studio.attachable.upload.subtitle", types: attachable_upload_type_labels(@allowed_content_types).to_sentence, size: number_to_human_size(@max_file_size)) %></p>
  <% end %>

  <template data-recording-studio-attachable--upload-target="progressTemplate">
    <%= render FlatPack::Progress::Component.new(value: 0, max: 100, label: t("recording_studio.attachable.upload.progress")) %>
  </template>

  <div class="flex min-h-80 flex-col gap-6">
    <div class="flex h-full min-h-[220px] flex-col gap-6">
      <div class="flex min-h-[220px] flex-col items-center justify-center gap-4 rounded-xl border border-dashed border-(--surface-border-color) p-10 text-center" data-recording-studio-attachable--upload-target="dropzone">
      <p class="text-sm text-(--surface-muted-content-color)"><%= t("recording_studio.attachable.upload.drag_and_drop") %></p>
      <input type="file" multiple class="hidden" data-recording-studio-attachable--upload-target="input" data-action="change->recording-studio-attachable--upload#filesSelected">
      <div class="flex w-full max-w-sm flex-col items-stretch gap-3">
        <%= render FlatPack::Button::Component.new(
          text: t("recording_studio.attachable.upload.choose_files"),
          style: :primary,
          size: :md,
          type: "button",
          icon: "upload",
          full_width: true,
          data: { action: "recording-studio-attachable--upload#browse" }
        ) %>

        <% if upload_providers.any? %>
          <% upload_providers.each do |provider| %>
            <% button_options = provider.button_options(view_context: self, recording: @recording, query_params: @upload_redirect_params).reverse_merge(full_width: true) %>
            <% button_options[:data] = button_options.fetch(:data, {}).merge(turbo_frame: "_top") if embedded %>
            <%= render FlatPack::Button::Component.new(**button_options) %>
          <% end %>
        <% end %>
      </div>
      </div>

      <div class="hidden space-y-4" data-recording-studio-attachable--upload-target="queue"></div>
    </div>
  </div>

  <% upload_providers.select(&:modal?).each do |provider| %>
    <% modal_id = provider.modal_id(recording: @recording) %>
    <%= render FlatPack::Modal::Component.new(
      id: modal_id,
      title: provider.modal_title(view_context: self, recording: @recording),
      size: provider.modal_size,
      body_height_mode: :fixed,
      body_height: "34rem"
    ) do |modal| %>
      <% modal.body do %>
        <div class="h-full overflow-hidden rounded-lg border border-(--surface-border-color) bg-(--surface-background-color)">
          <iframe
            title="<%= provider.iframe_title(view_context: self, recording: @recording) %>"
            class="h-136 w-full border-0"
            loading="lazy"
            data-provider-modal-frame
            data-provider-modal-id="<%= modal_id %>"></iframe>
        </div>
      <% end %>

      <% modal.footer do %>
        <%= render FlatPack::Button::Component.new(text: t("recording_studio.attachable.upload.close"), style: :secondary, size: :md, type: "button", data: { action: "flat-pack--modal#close" }) %>
      <% end %>
    <% end %>
  <% end %>
</div>
