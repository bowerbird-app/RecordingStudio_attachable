<% content_for :title, @page.title %>
<% content_for :subtitle, "Review the inline page content and related page actions." %>
<% flat_pack_page_nav(
  round: true,
  style: :default,
  back_icon: "chevron-left",
  back_tooltip: "Go back",
  anchor_href: request.referer.presence || root_path,
  anchor_tooltip: "Close"
) %>
<% register_page_nav "Edit inline", edit_page_path(@page), role: :primary %>
<div class="mx-auto flex w-full max-w-4xl flex-col gap-6">

  <div class="page-inline-content prose max-w-none text-(--surface-content-color)">
    <%= sanitize(
      @page.body.presence || "<p>No page content yet.</p>",
      tags: %w[p br strong em u s code blockquote ul ol li h1 h2 h3 a img figure figcaption],
      attributes: %w[href src alt title data-display data-align]
    ) %>
  </div>
</div>

<style>
  .page-inline-content img[data-display="small"] {
    width: 33% !important;
  }

  .page-inline-content img[data-display="medium"] {
    width: 50% !important;
  }

  .page-inline-content img[data-display="full"] {
    width: 100% !important;
  }

  .page-inline-content img[data-display] {
    max-width: 100%;
    height: auto;
    display: block;
  }

  .page-inline-content img[data-align="left"] {
    margin-left: 0 !important;
    margin-right: 0 !important;
  }

  .page-inline-content img[data-align="center"] {
    margin-left: auto !important;
    margin-right: auto !important;
  }

  .page-inline-content img[data-align="right"] {
    margin-left: auto !important;
    margin-right: 0 !important;
  }
</style>