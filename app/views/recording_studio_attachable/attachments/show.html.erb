<% navigation_params = attachment_navigation_params %>
<% content_for :title, @attachment.name %>
<% content_for :subtitle, @attachment.original_filename %>
<% flat_pack_page_nav(
  round: true,
  style: :default,
  back_tooltip: t("recording_studio.attachable.navigation.back"),
  anchor_href: attachment_page_nav_anchor_url(fallback: main_app.root_path),
  anchor_tooltip: t("recording_studio.attachable.navigation.return_to_source")
) %>
<% register_page_nav(
  t("recording_studio.attachable.attachments.download"),
  download_attachment_path(@attachment_recording),
  role: :secondary,
  icon: "arrow-down-tray",
  aria: { label: t("recording_studio.attachable.attachments.download_aria") },
  data: { turbo_frame: "_top" }
) %>
<% unless @attachment_recording.respond_to?(:trashed_at) && @attachment_recording.trashed_at.present? %>
  <% recording_studio_page_nav_right do %>
    <%= form_with url: destroy_attachment_path(@attachment_recording),
                  method: :delete,
                  class: "inline-flex",
                  data: { turbo_confirm: @place_labels.any? ? t("recording_studio_attachable.attachments.trash_in_use") : nil } do %>
      <%= render FlatPack::Button::Component.new(
        text: t("recording_studio.attachable.attachments.trash"),
        icon: "trash",
        style: :secondary,
        size: :sm,
        type: "submit",
        aria: { label: t("recording_studio.attachable.attachments.trash_aria") }
      ) %>
    <% end %>
  <% end %>
<% end %>
<div class="flex flex-col gap-6">
  <% if @place_labels.any? %>
    <%= render FlatPack::Alert::Component.new(
      title: t("recording_studio_attachable.attachments.used_in", count: @place_labels.size),
      description: [
        @place_labels.to_sentence,
        t("recording_studio_attachable.attachments.trash_in_use")
      ].compact_blank.join(" "),
      style: :warning
    ) %>
  <% end %>

  <div class="grid gap-6 lg:grid-cols-2 lg:items-start">
    <% preview_path = authorized_attachment_preview_path(@attachment_recording, :large) %>
    <% file_extension = File.extname(@attachment.original_filename.to_s).delete(".").upcase.presence || t("recording_studio.attachable.attachments.file_fallback") %>

    <div class="space-y-4">
      <%= render FlatPack::Card::Component.new(padding: :none) do |card| %>
        <% card.media aspect_ratio: "1/1", padding: :none, class: "relative bg-(--surface-muted-background-color)" do %>
          <% if preview_path.present? %>
            <div class="absolute inset-0" data-controller="recording-studio-attachable--image-fallback">
              <div class="absolute inset-0 flex items-stretch justify-stretch" data-recording-studio-attachable--image-fallback-target="skeleton">
                <%= render FlatPack::Skeleton::Component.new(variant: :rectangle, shimmer: true, width: "100%", height: "100%", class: "h-full w-full rounded-none") %>
              </div>
              <%= image_tag preview_path, alt: @attachment.name, class: "absolute inset-0 h-full w-full object-cover opacity-0 transition-opacity duration-200", data: { recording_studio_attachable__image_fallback_target: "image", action: "load->recording-studio-attachable--image-fallback#showImage error->recording-studio-attachable--image-fallback#showFallback" } %>
              <div class="absolute inset-0 hidden bg-(--surface-background-color)" data-recording-studio-attachable--image-fallback-target="fallback">
                <%= render FlatPack::EmptyState::Component.new(
                  title: t("recording_studio.attachable.attachments.image_fallback"),
                  description: t("recording_studio.attachable.attachments.preview_unavailable"),
                  icon: "exclamation-triangle",
                  size: :sm,
                  title_size: :xs,
                  description_size: :sm,
                  icon_size: :md,
                  width: :full,
                  class: "h-full w-full px-6! py-6!"
                ) %>
              </div>
            </div>
          <% else %>
            <div class="absolute inset-0 bg-(--surface-background-color)">
              <%= render FlatPack::EmptyState::Component.new(
                title: file_extension,
                icon: "document-text",
                size: :sm,
                title_size: :xs,
                icon_size: :md,
                width: :full,
                class: "h-full w-full px-6! py-6!"
              ) %>
            </div>
          <% end %>
        <% end %>
      <% end %>
    </div>

    <div id="edit-attachment" class="space-y-4 lg:col-start-2">
      <%= form_with model: @attachment, url: attachment_path(@attachment_recording, navigation_params), method: :patch, class: "space-y-4" do %>
        <div class="space-y-4">
          <%= render FlatPack::TextInput::Component.new(name: "attachment[name]", label: t("recording_studio.attachable.attachments.name"), value: @attachment.name, required: true) %>
          <%= render FlatPack::TextInput::Component.new(name: "attachment[caption]", label: t("recording_studio.attachable.attachments.caption"), value: @attachment.caption) %>
          <%= render FlatPack::TextInput::Component.new(name: "attachment[credit]", label: t("recording_studio.attachable.attachments.credit"), value: @attachment.credit) %>
          <%= render FlatPack::Tooltip::Component.new(text: t("recording_studio_attachable.attachments.alt_text_hint"), class: "w-full flex-col") do %>
            <%= render FlatPack::TextInput::Component.new(name: "attachment[alt_text]", label: t("recording_studio.attachable.attachments.alt_text"), value: @attachment.alt_text) %>
          <% end %>

          <%= render FlatPack::TextArea::Component.new(
            name: "attachment[description]",
            label: t("recording_studio.attachable.attachments.description"),
            value: @attachment.description,
            rows: 4
          ) %>
        </div>

        <%= render FlatPack::Button::Component.new(text: t("recording_studio.attachable.attachments.save"), style: :primary, size: :md, type: "submit") %>
      <% end %>
    </div>
  </div>
</div>
