<%= render FlatPack::Modal::Component.new(
  id: modal_id,
  title: modal_title,
  size: :xl,
  body_height_mode: :fixed,
  body_height: "32rem"
) do |modal| %>
  <% modal.body do %>
    <% cloud_upload_providers = RecordingStudioAttachable.configuration.upload_providers.select do |provider|
         provider.render?(view_context: self, recording: recording) && provider.client_picker?
       end %>
    <% upload_provider_launcher_modules(cloud_upload_providers).each do |module_path| %>
      <%= javascript_tag(%(import #{module_path.to_json}), type: "module", nonce: true) %>
    <% end %>

    <input
      type="file"
      accept="image/*"
      class="hidden"
      data-recording-studio-attachable--attachment-image-picker-target="fileInput"
      data-action="change->recording-studio-attachable--attachment-image-picker#uploadSelected">

    <template data-recording-studio-attachable--attachment-image-picker-target="progressTemplate">
      <%= render FlatPack::Progress::Component.new(value: 0, max: 100, label: t("recording_studio.attachable.picker.progress")) %>
    </template>

    <p class="hidden text-sm text-(--surface-muted-content-color)" data-recording-studio-attachable--attachment-image-picker-target="status"></p>

    <div class="hidden space-y-3" data-recording-studio-attachable--attachment-image-picker-target="uploadQueue"></div>

    <%= render FlatPack::Picker::Component.new(
      id: "#{modal_id}-picker",
      title: nil,
      modal: false,
      variant: :flush,
      size: :xl,
      selection_mode: :multiple,
      auto_confirm: false,
      accepted_kinds: %w[image],
      search_mode: :remote,
      search_endpoint: picker_url,
      search_param: "q",
      search_placeholder: t("recording_studio.attachable.picker.search_placeholder"),
      results_layout: :grid,
      items_height: "20rem",
      modal_body_height_mode: :auto,
      confirm_label: t("recording_studio.attachable.picker.add_selected"),
      close_label: t("recording_studio.attachable.picker.clear")
    ) do |picker| %>
      <% picker.with_toolbar do %>
        <%= render FlatPack::Button::Dropdown::Component.new(text: t("recording_studio.attachable.picker.upload"), style: :primary, size: :md) do |dropdown| %>
          <% dropdown.menu_item(
            text: t("recording_studio.attachable.picker.upload_from_device"),
            icon: "upload",
            href: "#",
            data: { action: "recording-studio-attachable--attachment-image-picker#browseUpload" }
          ) %>

          <% if cloud_upload_providers.any? %>
            <% dropdown.menu_divider %>

            <% cloud_upload_providers.each do |provider| %>
              <% provider_button_options = provider.button_options(view_context: self, recording: recording) %>
              <% dropdown.menu_item(
                text: provider_button_options[:text],
                icon: provider_button_options[:icon],
                href: "#",
                data: provider_button_options.fetch(:data, {}).merge(
                  action: "recording-studio-attachable--attachment-image-picker#launchProvider"
                )
              ) %>
            <% end %>
          <% end %>
        <% end %>
      <% end %>

      <% picker.with_empty do %>
        <%= empty_state_text %>
      <% end %>
    <% end %>
  <% end %>
<% end %>
